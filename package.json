{
  "name": "evol-eye",
  "private": true,
  "version": "0.1.1",
  "description": "A real-time intelligence console for planet Earth — photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "R0U5",
  "homepage": "https://github.com/R0U5/Evol-Eye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/R0U5/Evol-Eye.git"
  },
  "bugs": {
    "url": "https://github.com/R0U5/Evol-Eye/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "installer:test": "node --test installer/zipcode.test.mjs installer/core.test.mjs installer/runner.test.mjs installer/server.test.mjs",
    "installer:build": "node installer/build.mjs",
    "installer:exe": "node installer/build.mjs",
    "installer:exe:selftest": "node installer/build.mjs --selftest-only",
    "installer:build:legacy": "node scripts/installer/build.mjs",
    "installer:dev": "node installer/server.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}
